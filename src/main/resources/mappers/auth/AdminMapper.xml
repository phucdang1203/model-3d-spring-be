<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.innervix.model3d.domain.auth.mapper.AdminMapper">
    <resultMap id="AdminUserMap" type="com.innervix.model3d.domain.auth.model.AdminUser">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="username" javaType="string"/>
            <arg column="password_hash" javaType="string"/>
            <arg column="display_name" javaType="string"/>
            <arg column="role" javaType="string"/>
            <arg column="enabled" javaType="boolean"/>
        </constructor>
    </resultMap>

    <select id="findByUsername" resultMap="AdminUserMap">
        SELECT id, username, password_hash, display_name, role, enabled
        FROM admin_users
        WHERE username = #{username}
    </select>

    <select id="existsAny" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM admin_users LIMIT 1)
    </select>

    <insert id="create">
        INSERT INTO admin_users (username, password_hash, display_name, role, enabled)
        VALUES (#{username}, #{passwordHash}, #{displayName}, 'ADMIN', 1)
    </insert>
</mapper>
